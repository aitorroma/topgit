{
  "id": "/",
  "name": "TOP GIT",
  "short_name": "TOP GIT",
  "description": "Share GitHub and GitLab repositories directly to TOP GIT.",
  "lang": "en",
  "start_url": "/install.html",
  "scope": "/",
  "display": "standalone",
  "background_color": "#f8fafc",
  "theme_color": "#FF4B4B",
  "icons": [
    {
      "src": "/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "share_target": {
    "action": "/share.html",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  }
}
